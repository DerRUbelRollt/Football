# Kopieren nach .env.docker und Werte anpassen. .env.docker ist gitignored
# und wird von docker-compose per --env-file eingelesen (siehe README.md).

# --- Postgres ---
POSTGRES_USER=teamcompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teamcompass

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production

# --- Images (nur fuer den Server-Pull relevant, siehe README.md / deploy.md) ---
BACKEND_IMAGE=ghcr.io/derrubelrollt/teamcompass-backend:latest
FRONTEND_IMAGE=ghcr.io/derrubelrollt/teamcompass-frontend:latest

# --- Nur fuer docker-compose.prod.yml (Caddy/TLS) ---
DOMAIN=teamcompass.example.com
