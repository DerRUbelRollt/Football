# Kopieren nach .env.docker und Werte anpassen. .env.docker ist gitignored
# und wird von docker-compose per --env-file eingelesen (siehe README.md).

# --- Postgres ---
POSTGRES_USER=teamcompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teamcompass

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Production

# --- Nur fuer docker-compose.prod.yml (Caddy/TLS) ---
DOMAIN=teamcompass.example.com
